node_modules/
dist/
# Test-coverage reports only: a bare `coverage/` would also hide src/modules/coverage.
/coverage/
/apps/*/coverage/
/packages/*/coverage/
.env
.env.*
!.env.example
*.log
.DS_Store
.vite/
apps/api/src/generated/
apps/api/storage/

# Dev-server-only demo logins (never loaded by production builds)
!apps/*/.env.development

# Python packages cached by the lesson code verifier
.cache/

# Production data exports (they hold the hiring data): never commit them.
/deploy/data/

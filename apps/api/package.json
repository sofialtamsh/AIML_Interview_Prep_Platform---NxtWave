{
  "name": "@app/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "dev:worker": "tsx watch --clear-screen=false src/worker.ts",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "admin:create": "tsx src/cli/create-admin.ts",
    "db:bootstrap": "tsx src/cli/bootstrap-catalog.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@app/content": "workspace:*",
    "@app/contracts": "workspace:*",
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "6.1.2",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.9",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "6.2.13",
    "nodemailer": "10.3.1",
    "openapi-types": "12.1.3",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "pyodide": "314.0.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "vitest": "4.1.12"
  }
}

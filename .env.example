# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
APP_NAME="NxtWave Prep"
LOG_LEVEL=info

# API
API_HOST=127.0.0.1
API_PORT=4000
TRUST_PROXY=false
RATE_LIMIT_ENABLED=true

# Database (docker compose exposes Postgres on 45432)
DATABASE_URL=postgresql://prep:prep@127.0.0.1:45432/prep?schema=public
DATABASE_URL_TEST=postgresql://prep:prep@127.0.0.1:45432/prep_test?schema=public

# Frontend origins (used for links in emails and the CSRF Origin allow-list)
STUDENT_APP_URL=http://localhost:5310
ADMIN_APP_URL=http://localhost:5320

# Email (Mailpit in development: http://localhost:8025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NxtWave Prep <no-reply@prep.local>"

# Who may create student accounts: OPEN | ALLOWLIST | INVITE_ONLY
# (admins can change this later in Settings; this is only the initial default)
REGISTRATION_POLICY_DEFAULT=OPEN
REQUIRE_EMAIL_VERIFICATION=false

# Development seed only (pnpm db:seed). Never used in production.
SEED_SUPER_ADMIN_EMAIL=admin@prep.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe-Admin-2026!
# A ready-made student (goal already set) for quick checks of the student app.
SEED_DEMO_STUDENT_EMAIL=demo.student@prep.local
SEED_DEMO_STUDENT_PASSWORD=Demo-Student-2026!

# The login screens show these demo accounts in local dev via apps/*/.env.development.

# "Continue with Google" (optional). Create an OAuth client (type: Web application) in Google Cloud
# Console and add these Authorized redirect URIs:
#   http://localhost:5310/api/v1/auth/google/callback
#   http://localhost:5320/api/v1/admin/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Admin Google sign-in is limited to these email domains (comma-separated). Admins must still be invited.
ADMIN_GOOGLE_ALLOWED_DOMAINS=nxtwave.co.in

# AI content agents (admin only). Keys stay server-side: never in the apps, logs or database.
# Paste your key here (not in chat). With no key, AI generation is switched off.
ANTHROPIC_API_KEY=
# auto (Claude when a key is set) | anthropic | simulated (demo/test stand-in, never production) | off
AI_PROVIDER=auto
# A single AI job stops before spending more than this many US dollars.
AI_JOB_BUDGET_USD=5
OPENAI_API_KEY=
